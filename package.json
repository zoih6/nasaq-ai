{
  "name": "nasaq-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nasaq/web",
    "build": "npm run build --workspace=@nasaq/web",
    "start": "npm run start --workspace=@nasaq/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=@nasaq/web",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  }
}
